{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.476",
    "@remotion/tailwind-v4": "4.0.476",
    "@remotion/zod-types": "4.0.476",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.476",
    "tailwindcss": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.476",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "validate:audio": "node scripts/validate_audio_assets.js",
    "render": "npm run validate:audio && remotion render TriviaVideo out/trivia_video_1080p.mp4 --pixel-format=yuv420p --concurrency=6",
    "render:max": "npm run validate:audio && remotion render TriviaVideo out/trivia_video_1080p.mp4 --pixel-format=yuv420p --concurrency=8"
  },
  "sideEffects": [
    "*.css"
  ]
}
